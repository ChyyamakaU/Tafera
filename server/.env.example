# Tafera backend environment variables
# Copy this file to .env and fill in your own values. Never commit .env.

# Node environment: development, test or production
NODE_ENV=development
PORT=5001
TRUST_PROXY=false

# Client URL (used for verification links and CORS)
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://tafera:tafera_password@localhost:5432/tafera
# Or use individual DB_* variables instead of DATABASE_URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tafera
# DB_USER=tafera
# DB_PASSWORD=

# Redis (used for sessions and rate limiting)
REDIS_URL=redis://localhost:6379

# Session security (must be at least 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_NAMESPACE=tafera

# JWT (optional; required when authentication is implemented)
# JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# JWT_REFRESH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Email (Brevo) - optional. Email delivery works without these and is
# reported as unconfigured. Both must be set together if either is set.
BREVO_API_KEY=brevo_your_brevo_api_key
EMAIL_FROM=noreply@example.com

# Email verification (optional overrides)
EMAIL_VERIFICATION_TOKEN_TTL=24h

# Argon2 password hashing
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENCY=2
ARGON2_MAX_QUEUE=50

# Cloudinary (optional; all three must be set together if any is set)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
