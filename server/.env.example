# ---------------------------------------------------------------------------
# Tafera API environment configuration
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Required for local development:
#   DB_NAME, DB_USER, SESSION_SECRET
#   Development defaults are provided for NODE_ENV, PORT, CLIENT_URL,
#   DB_HOST, DB_PORT and REDIS_URL.
#
# Required in production:
#   NODE_ENV=production, CLIENT_URL, REDIS_URL, SESSION_SECRET
#   plus either DATABASE_URL or the full DB_* set
#
# Required only when the related feature is enabled:
#   JWT_*        when authentication is implemented
#   CLOUDINARY_* when image uploads are implemented
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# Express `trust proxy` setting.
# false: direct connections (safe local development default)
# 1: trust one reverse-proxy hop (typical for Render, Heroku or nginx)
# true: trust all proxy hops; only use when the entire network path is trusted
TRUST_PROXY=false

# PostgreSQL
# Use either DATABASE_URL or the DB_* variables.
# DATABASE_URL takes precedence in development and production.
# The test environment always uses ${DB_NAME}_test.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tafera
DB_USER=tafera_user
DB_PASSWORD=
DATABASE_URL=

# Redis (required at runtime; no default in production)
REDIS_URL=redis://localhost:6379

# Sessions (required, minimum 32 characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Password hashing (Argon2id)
# Defaults follow the OWASP baseline: 19456 KiB, timeCost 2, parallelism 1.
# The higher-memory alternative 47104 KiB with timeCost 1 is also acceptable.
#
# Aggregate memory: ARGON2_MEMORY_KIB × ARGON2_MAX_CONCURRENCY must be at most
# 131072 KiB (128 MiB). Startup fails when this budget is exceeded.
#
# Queue: at most ARGON2_MAX_QUEUE password operations wait for a free slot.
# Once both the active slots and the waiting queue are full, requests receive
# a safe 503 PASSWORD_SERVICE_BUSY response instead of consuming more memory.
# Values above Node's libuv thread pool size (4 by default) mostly queue.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENCY=2
ARGON2_MAX_QUEUE=50

# JWT (optional until authentication is implemented)
# When authentication is added, both secrets become required and must each be
# at least 32 characters.
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (optional until image uploads are implemented)
# When image uploads are added, all three values become required.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
